# TrvicERP Backend - Production Environment Configuration
# 複製此檔案為 .env 並填入實際值

# ===========================================
# 環境設定
# ===========================================
ENVIRONMENT=production
DEBUG=false

# ===========================================
# 資料庫設定 (Supabase PostgreSQL)
# ===========================================
# 從 Supabase Dashboard > Settings > Database 取得
# 格式: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.xxxxx:your-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Supabase API (用於 Storage 和 Auth)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 連接池設定
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ===========================================
# JWT 認證
# ===========================================
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS 設定
# ===========================================
# 允許的前端網域（逗號分隔）
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ===========================================
# 伺服器設定
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
SERVER_RELOAD=false

# ===========================================
# LINE Messaging API
# ===========================================
# 從 LINE Developers Console 取得
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_NOTIFY_TOKEN=your-line-notify-token

# ===========================================
# 金流設定 - 綠界 ECPay
# ===========================================
# 從綠界商家後台取得
ECPAY_MERCHANT_ID=your-merchant-id
ECPAY_HASH_KEY=your-hash-key
ECPAY_HASH_IV=your-hash-iv
ECPAY_SANDBOX=false

# ===========================================
# 電子發票 API
# ===========================================
EINVOICE_APP_ID=your-einvoice-app-id
EINVOICE_API_KEY=your-einvoice-api-key

# ===========================================
# 外部服務 API
# ===========================================
# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# 錯誤監控 - Sentry
# ===========================================
# 從 Sentry Dashboard 取得
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
