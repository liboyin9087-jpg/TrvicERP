# Backend API Server Configuration
# TrvicERP P0 Production-Ready Setup

# ===================
# Database Configuration
# ===================
# SQLite for development:
DATABASE_URL=sqlite:///./trvicerp.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/trvicerp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ===================
# Environment
# ===================
ENVIRONMENT=development
# Options: development, staging, production

# ===================
# JWT Authentication
# ===================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================
# CORS Settings
# ===================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ===================
# Server Configuration
# ===================
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
SERVER_RELOAD=true

# ===================
# WebSocket Configuration
# ===================
WS_HEARTBEAT_INTERVAL=30

# ===================
# LINE Messaging API (P0)
# ===================
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ===================
# Stripe Payment Integration (P0)
# ===================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=twd

# ===================
# Email Service - SMTP (P0)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@trvicerp.com
SMTP_FROM_NAME=TrvicERP
SMTP_USE_TLS=true

# ===================
# Sentry Error Tracking (P0)
# ===================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===================
# Rate Limiting (P0)
# ===================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===================
# Redis (Optional - for caching and background tasks)
# ===================
REDIS_URL=redis://localhost:6379/0

# ===================
# Security
# ===================
SECRET_KEY=your-app-secret-key-change-in-production
ALLOWED_HOSTS=*
