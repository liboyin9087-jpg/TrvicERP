# AI Server environment variables
# Copy to .env (do not commit .env files)

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEFAULT_MAX_TOKENS=4096
GEMINI_GENERAL_MAX_TOKENS=4000
GEMINI_LEGAL_MAX_TOKENS=8000
GEMINI_MARKETING_MAX_TOKENS=8000
GOOGLE_API_KEY=your_gemini_api_key_here
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_MARKETING_MODEL=Qwen/Qwen2.5-32B-Instruct
SILICONFLOW_MARKETING_TEMPERATURE=0.7
SILICONFLOW_MARKETING_MAX_TOKENS=15000
SILICONFLOW_API_KEY=your_siliconflow_key_here
BFL_BASE_URL=https://api.bfl.ml/v1
BFL_MODEL=flux-pro
BFL_API_STYLE=auto
BFL_API_KEY=your_bfl_api_key_here
