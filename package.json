{
  "name": "trivicerp",
  "version": "3.2.0",
  "description": "TrivcERP - 台灣旅遊業開源 ERP 系統 (含 AI 智能、RFP 比價、反雷資料庫)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "erp",
    "travel",
    "taiwan",
    "react",
    "typescript",
    "supabase",
    "ai",
    "llm",
    "pwa"
  ],
  "author": "TrivcERP Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liboyin9087-jpg/TrivcERP"
  },
  "bugs": {
    "url": "https://github.com/liboyin9087-jpg/TrivcERP/issues"
  },
  "homepage": "https://github.com/liboyin9087-jpg/TrivcERP#readme"
