{
    "api": {
        "_comment": "SiliconFlow API 配置",
        "base_url": "https://api.siliconflow.com/v1/chat/completions",
        "api_key": "",
        "model": "Qwen/Qwen2.5-72B-Instruct",

        "_comment_rate_limiting": "Rate Limiting 配置，避免 API 呼叫過於密集",
        "requests_per_minute": 10,
        "min_delay_between_requests": 6.0,
        "max_retries": 5,
        "retry_base_delay": 10.0,

        "_comment_tokens": "Token 配置",
        "max_tokens_per_request": 4096,
        "max_context_tokens": 6000
    },

    "scan": {
        "_comment": "檔案掃描配置",
        "max_file_size_mb": 10,
        "supported_extensions": [
            ".py", ".js", ".ts", ".tsx", ".jsx", ".vue",
            ".html", ".css", ".scss", ".json", ".yaml", ".yml",
            ".md", ".txt", ".sql", ".sh", ".toml", ".ini", ".cfg",
            ".env.example", ".gitignore", ".dockerignore", "Dockerfile"
        ],
        "excluded_dirs": [
            "node_modules", "__pycache__", ".git", ".venv",
            "venv", "env", "dist", "build", ".next", ".nuxt",
            "coverage", ".pytest_cache", ".trvic_sessions"
        ],
        "excluded_files": [
            "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb"
        ]
    },

    "session": {
        "_comment": "Session 持久化配置",
        "session_dir": ".trvic_sessions",
        "output_dir": "analysis_reports",
        "auto_save_interval": 60
    },

    "agents": {
        "_comment": "五位專家的執行順序，可自行調整",
        "order": [
            "software_engineer",
            "ai_solution",
            "business_development",
            "brand_strategy",
            "ui_ux"
        ],
        "descriptions": {
            "software_engineer": "軟體工程師 - 程式碼品質、架構設計、效能優化",
            "ai_solution": "AI解決方案架構師 - AI整合、智能自動化、數據管道",
            "business_development": "商業發展總監 - 商業模式、市場定位、營收策略",
            "brand_strategy": "品牌策略顧問 - 品牌定位、用戶洞察、內容策略",
            "ui_ux": "UI/UX設計主管 - 用戶體驗、介面設計、可用性"
        }
    },

    "validation": {
        "_comment": "驗證迴圈配置（參考 everything-claude-code）",
        "enabled": true,
        "auto_checkpoint": true,
        "min_analysis_length": 100
    },

    "learning": {
        "_comment": "持續學習配置",
        "enabled": true,
        "patterns_file": ".trvic_patterns.json",
        "max_patterns": 100
    },

    "commands": {
        "_comment": "斜線命令配置",
        "enabled": true,
        "available": [
            "/analyze", "/verify", "/learn", "/checkpoint",
            "/status", "/agents", "/sessions", "/resume",
            "/export", "/fix", "/help", "/quit"
        ]
    }
}
