{
    "api": {
        "base_url": "https://api.siliconflow.com/v1/chat/completions",
        "api_key": "",
        "model": "Qwen/Qwen2.5-72B-Instruct",

        "_comment_rate_limiting": "Rate Limiting 配置",
        "requests_per_minute": 10,
        "min_delay_seconds": 6.0,
        "max_retries": 5,
        "retry_base_delay": 10.0,

        "_comment_tokens": "Token 配置",
        "max_tokens_per_request": 4096,
        "max_context_tokens": 8000
    },

    "scan": {
        "max_file_size_mb": 10,
        "supported_extensions": [
            ".py", ".js", ".ts", ".tsx", ".jsx", ".vue",
            ".html", ".css", ".scss", ".json", ".yaml", ".yml",
            ".md", ".txt", ".sql", ".sh", ".toml", ".ini", ".cfg"
        ],
        "excluded_dirs": [
            "node_modules", "__pycache__", ".git", ".venv",
            "venv", "env", "dist", "build", ".next", ".nuxt",
            "coverage", ".pytest_cache", ".trvic_sessions", "analysis_reports"
        ],
        "excluded_files": [
            "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb"
        ]
    },

    "output": {
        "output_dir": "analysis_reports",
        "generate_markdown": true,
        "generate_json": true
    },

    "experts": {
        "_comment": "五位專家的執行順序",
        "order": [
            "software_engineer",
            "ai_solution",
            "business_development",
            "brand_strategy",
            "ui_ux"
        ],

        "descriptions": {
            "software_engineer": "軟體工程：程式碼品質、架構設計、效能優化、安全性",
            "ai_solution": "AI 解決方案：智能自動化、數據管道、LLM 整合",
            "business_development": "商業發展：商業模式、市場定位、營收策略",
            "brand_strategy": "品牌策略：品牌定位、用戶洞察、內容策略",
            "ui_ux": "UI/UX 設計：用戶體驗、介面設計、可用性"
        }
    }
}
