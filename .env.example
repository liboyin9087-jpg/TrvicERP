# ==============================================
# TrvicERP 環境變數配置
# Environment Variables Configuration
# ==============================================
# 複製此檔案為 .env 並填入實際值
# Copy this file to .env and fill in actual values
# ==============================================

# ------------------------------------------
# 🔐 Supabase 配置 (資料庫與認證)
# Supabase Configuration (Database & Auth)
# ------------------------------------------

# 前端使用 (會被打包進 bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 後端使用（Supabase Edge Functions / 後端服務端才會用到）
# ⚠️ 前端部署到 Vercel 時，請不要把下列 key 設在 Vercel 的環境變數（會暴露）
# ✅ 正確做法：用 `supabase secrets set ...` 設在 Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------
# 🤖 AI/LLM 配置（後端 / Supabase Edge Functions）
# AI/LLM Configuration (Server-side only; set via `supabase secrets set`)
# ------------------------------------------

# OpenAI (預設 Provider)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (可選)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# GitHub Models (可選，免費)
GITHUB_TOKEN=ghp_your-github-token
GITHUB_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# Hugging Face (可選)
HF_API_KEY=hf_your-huggingface-token
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Remote Ollama (可選，自建伺服器)
OLLAMA_BASE_URL=http://your-ollama-server:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------
# 🤖 AI/LLM 配置 (前端/開發用)
# AI/LLM Configuration (Frontend/Development)
# ------------------------------------------

# LLM 提供者選擇
# 生產環境：建議使用 supabase-edge（API key 不落地到前端）
# 開發環境：推薦使用 ollama
# 可選值: supabase-edge, vercel-proxy, ollama, github-models, huggingface, openai-compatible
VITE_LLM_PROVIDER=supabase-edge

# 本地 Ollama 配置（僅開發用）
# VITE_LLM_PROVIDER=ollama
# VITE_LLM_BASE_URL=http://localhost:11434/api
# VITE_LLM_MODEL=llama3.2:3b

# ⚠️ 警告：以下變數會暴露在前端，生產環境請勿使用
# VITE_LLM_API_KEY=（僅限開發環境使用 Ollama 以外的 Provider）

# ------------------------------------------
# 🌦 天氣 API 配置 (選用)
# Weather API Configuration (Optional)
# ------------------------------------------

# 天氣提供者: openweathermap, open-meteo, cwa
# open-meteo 免費且無需 API Key
VITE_WEATHER_PROVIDER=open-meteo

# OpenWeatherMap API Key
# 註冊: https://openweathermap.org/api (免費: 1,000 calls/day)
VITE_WEATHER_API_KEY=your-openweathermap-key

# 台灣中央氣象署 API Key (可選)
VITE_CWA_API_KEY=your-cwa-api-key

# ------------------------------------------
# 📊 監控與分析 (選用)
# Monitoring & Analytics (Optional)
# ------------------------------------------

# Sentry 錯誤追蹤
VITE_SENTRY_DSN=https://your-sentry-dsn

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics (自動啟用)
# 無需設定

# ------------------------------------------
# 🔧 應用程式配置
# Application Configuration
# ------------------------------------------

# 應用程式 URL (用於 OAuth callback)
VITE_APP_URL=http://localhost:3000

# 應用程式名稱
VITE_APP_NAME=TrvicERP

# 預設貨幣
VITE_DEFAULT_CURRENCY=TWD

# 預設語言
VITE_DEFAULT_LOCALE=zh-TW

# ------------------------------------------
# 🔒 安全配置
# Security Configuration
# ------------------------------------------

# Rate Limiting (Upstash Redis，生產環境建議)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# JWT Secret (如需自訂 JWT)
# JWT_SECRET=your-secret-key

# ------------------------------------------
# 📧 Email 配置 (未來功能)
# Email Configuration (Future Feature)
# ------------------------------------------

# Resend API Key
# RESEND_API_KEY=re_your-resend-key

# SMTP 配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# ------------------------------------------
# 💳 付款配置 (未來功能)
# Payment Configuration (Future Feature)
# ------------------------------------------

# Stripe
# STRIPE_SECRET_KEY=sk_test_your-stripe-key
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# 藍新金流 (NewebPay)
# NEWEBPAY_MERCHANT_ID=your-merchant-id
# NEWEBPAY_HASH_KEY=your-hash-key
# NEWEBPAY_HASH_IV=your-hash-iv

# ------------------------------------------
# 🧪 測試配置
# Testing Configuration
# ------------------------------------------

# 測試資料庫 (與生產分離)
# TEST_SUPABASE_URL=https://test-project.supabase.co
# TEST_SUPABASE_ANON_KEY=test-anon-key

# E2E 測試 Base URL
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# ------------------------------------------
# ⚠️ 安全提醒 / Security Reminders
# ------------------------------------------
#
# 1. 所有 VITE_ 開頭的變數會被打包進前端程式碼
#    All VITE_ prefixed variables will be bundled
#
# 2. 敏感 API Key 絕對不要使用 VITE_ 前綴
#    Never use VITE_ prefix for sensitive API keys
#
# 3. 生產環境請使用 Vercel 環境變數管理
#    Use Vercel environment variables for production
#
# 4. 切勿將 .env 檔案提交到版本控制
#    Never commit .env files to version control
#
# 5. 定期輪換 API Key
#    Rotate API keys regularly
#
