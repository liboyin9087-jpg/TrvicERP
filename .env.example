# TrvicERP 環境變數配置範例
# 複製此檔案為 .env 並填入實際值

# ============================================
# API 設定
# ============================================

# 後端 API 基礎 URL
# 開發環境預設: http://localhost:4000
# 生產環境: 請填入實際的 API 伺服器 URL
VITE_API_URL=http://localhost:4000

# ============================================
# AI 服務
# ============================================

# AI Copilot 後端伺服器 URL
# 本地開發：http://localhost:4000
# 生產環境：填入實際的 AI 服務 URL
VITE_AI_SERVER_URL=http://localhost:4000

# SiliconFlow API 金鑰 (前端直連，可選)
# 用於景點推薦等功能
# 取得方式：https://cloud.siliconflow.cn/
VITE_SILICONFLOW_API_KEY=

# SiliconFlow API 基礎 URL (可選)
VITE_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow 模型名稱 (可選)
# 預設: Qwen/Qwen2.5-32B-Instruct
VITE_SILICONFLOW_MODEL=Qwen/Qwen2.5-32B-Instruct

# LLM 參數設定 (可選)
VITE_LLM_TEMPERATURE=0.3
VITE_LLM_MAX_TOKENS=4000

# Google Gemini API 金鑰 (舊版支援)
# 用於 AI 助手功能（EdgeAssistant, LegalAssistant）
# 如不需要 AI 功能，可留空
GEMINI_API_KEY=

# ============================================
# 功能開關 (可選)
# ============================================

# 啟用開發模式（顯示除錯資訊）
# VITE_DEV_MODE=true

# 啟用 Mock 資料模式（當後端未就緒時使用）
# VITE_USE_MOCK=false

# ============================================
# 第三方服務
# ============================================

# TDX 運輸資料 API (台灣景點/交通查詢)
# 申請網址: https://tdx.transportdata.tw/
VITE_TDX_CLIENT_ID=
VITE_TDX_CLIENT_SECRET=

# 中央氣象署 OpenData API (天氣預報)
# 申請網址: https://opendata.cwa.gov.tw/
VITE_CWA_API_KEY=

# LINE Messaging API (客服功能)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# ============================================
# 注意事項
# ============================================
# 1. 不要將 .env 檔案提交到版本控制系統
# 2. 生產環境的環境變數應透過部署平台設定
# 3. 敏感資訊（如 API 金鑰）不應出現在前端程式碼中
# 4. 所有 VITE_ 開頭的變數會在前端程式碼中可訪問
