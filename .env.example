# TravelMaster ERP 環境變數設定
# 複製此檔案為 .env.local 並填入實際值

# API 配置
# 後端 API 位址（預設為 localhost:4000）
VITE_API_URL=http://localhost:4000
# AI API 位址（預設為 localhost:4000）
VITE_AI_API_URL=http://localhost:4000
# WebSocket 位址
VITE_WS_URL=wss://your_ws_url_here
# LINE API 位址
VITE_LINE_API_URL=http://localhost:4000/api/v1/line

# App 位址（用於 Line 回呼等）
VITE_APP_URL=http://localhost:4000

# 認證模式
# 設為 false 以使用真實 API 認證，否則使用 Mock 模式
VITE_USE_MOCK=true

# Gemini API (用於 AI 文案生成)
GEMINI_API_KEY=your_gemini_api_key_here

# 天氣 API (OpenWeatherMap)
VITE_WEATHER_PROVIDER=openweathermap
VITE_WEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5
