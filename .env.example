# TrvicERP Frontend - 環境變數設定
# 複製此檔案為 .env.local (開發) 或在 Vercel Dashboard 設定 (生產)

# ===========================================
# 環境模式
# ===========================================
# 開發環境預設使用 Mock 模式
# 生產環境（Vercel）自動使用真實 API
# 若需強制覆蓋：
# VITE_USE_MOCK=true  (強制 Mock)
# VITE_USE_MOCK=false (強制真實 API)

# ===========================================
# 後端 API 設定 (P0 必填)
# ===========================================
# 開發環境
VITE_API_URL=http://localhost:4000

# 生產環境 - 替換為您的後端部署網址
# Railway: https://your-app.railway.app
# Render: https://your-app.onrender.com
# Fly.io: https://your-app.fly.dev
# VITE_API_URL=https://trvicerp-api.railway.app

# API 版本
VITE_API_VERSION=v1

# ===========================================
# Supabase 設定 (P0 必填)
# ===========================================
# 從 Supabase Dashboard > Settings > API 取得
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# AI 服務設定
# ===========================================
VITE_AI_API_URL=http://localhost:4000

# ===========================================
# WebSocket 設定
# ===========================================
# 開發環境
VITE_WS_URL=ws://localhost:4000/ws

# 生產環境 - 使用 wss://
# VITE_WS_URL=wss://trvicerp-api.railway.app/ws

# ===========================================
# LINE 整合
# ===========================================
VITE_LINE_API_URL=http://localhost:4000/api/v1/line

# LINE LIFF App ID (用於 LINE 內建瀏覽器)
VITE_LINE_LIFF_ID=your-liff-id

# ===========================================
# App 位址
# ===========================================
# 用於 OAuth callback、LINE 回呼等
VITE_APP_URL=http://localhost:5173

# ===========================================
# 天氣 API
# ===========================================
VITE_WEATHER_PROVIDER=openweathermap
VITE_WEATHER_API_KEY=your_openweather_api_key
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# 或使用中央氣象署
# VITE_WEATHER_PROVIDER=cwb
# VITE_WEATHER_API_KEY=your_cwa_api_key
# VITE_WEATHER_API_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# ===========================================
# 功能開關
# ===========================================
# 啟用/停用特定功能
VITE_FEATURE_AI_COPILOT=true
VITE_FEATURE_LINE_NOTIFY=true
VITE_FEATURE_PAYMENT=false

# ===========================================
# 開發工具
# ===========================================
# Mock API 延遲 (毫秒)
VITE_MOCK_LATENCY_MS=120

# ===========================================
# Figma 設計整合
# ===========================================
# 從 Figma > Settings > Personal Access Tokens 取得
VITE_FIGMA_API_KEY=your_figma_api_key_here

# ===========================================
# 錯誤監控 (Sentry)
# ===========================================
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# Google Analytics
# ===========================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
