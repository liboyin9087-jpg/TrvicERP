# TrvicERP 環境變數配置範例
# 複製此檔案為 .env 並填入實際值

# ============================================
# API 設定
# ============================================

# 後端 API 基礎 URL
# 開發環境預設: http://localhost:5000
# 生產環境: 請填入實際的 API 伺服器 URL
VITE_API_URL=http://localhost:5000

# ============================================
# AI 服務 (可選)
# ============================================

# Google Gemini API 金鑰
# 用於 AI 助手功能（EdgeAssistant, LegalAssistant）
# 如不需要 AI 功能，可留空
GEMINI_API_KEY=

# ============================================
# 功能開關 (可選)
# ============================================

# 啟用開發模式（顯示除錯資訊）
# VITE_DEV_MODE=true

# 啟用 Mock 資料模式（當後端未就緒時使用）
# VITE_USE_MOCK=false

# ============================================
# 第三方服務 (可選)
# ============================================

# LINE Messaging API Channel Access Token
# 用於 LINE 客服功能
# LINE_CHANNEL_ACCESS_TOKEN=

# LINE Messaging API Channel Secret
# LINE_CHANNEL_SECRET=

# ============================================
# 注意事項
# ============================================
# 1. 不要將 .env 檔案提交到版本控制系統
# 2. 生產環境的環境變數應透過部署平台設定
# 3. 敏感資訊（如 API 金鑰）不應出現在前端程式碼中
# 4. 所有 VITE_ 開頭的變數會在前端程式碼中可訪問
