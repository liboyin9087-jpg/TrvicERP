# =============================================================================
# TravelMaster ERP 環境變數設定
# =============================================================================
# 
# 📋 使用說明：
# 1. 複製此檔案為 .env.local（本機開發）或設定於 Vercel Dashboard（生產環境）
# 2. 填入實際的 API URL 和金鑰
# 3. 設定 VITE_USE_MOCK=false 以使用真實 API
#
# ⚠️ Vercel 部署注意事項：
# - 在 Vercel Dashboard → Settings → Environment Variables 設定這些變數
# - 所有 VITE_ 開頭的變數會在建置時嵌入前端程式碼
# - 請確保 Supabase URL 和 Key 正確設定
#
# =============================================================================

# -----------------------------------------------------------------------------
# API 配置
# -----------------------------------------------------------------------------
# 後端 API 位址
# 本機開發: http://localhost:4000
# 生產環境: https://your-backend.railway.app 或 https://your-api.render.com
VITE_API_URL=http://localhost:4000

# AI API 位址
VITE_AI_API_URL=http://localhost:4000

# WebSocket 位址
# 本機開發: ws://localhost:4000
# 生產環境: wss://your-backend.railway.app
VITE_WS_URL=ws://localhost:4000

# LINE API 位址
VITE_LINE_API_URL=http://localhost:4000/api/v1/line

# App 位址（用於 LINE 回呼等）
VITE_APP_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# 認證模式（重要！）
# -----------------------------------------------------------------------------
# true  = 使用 Mock 模式（本機開發、測試）
# false = 使用 Supabase 真實認證（生產環境）
#
# ⚠️ 部署到 Vercel 時，請設定為 false 並確保 Supabase 設定正確
VITE_USE_MOCK=true

# -----------------------------------------------------------------------------
# Supabase 配置（生產環境必填）
# -----------------------------------------------------------------------------
# 🔗 取得方式：Supabase Dashboard → Settings → API
#
# Project URL（格式：https://xxxxxxxxxxxx.supabase.co）
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon Public Key（公開金鑰，用於前端認證）
VITE_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# 連線檢查（可選）
# -----------------------------------------------------------------------------
# 啟用時會在 Console 顯示連線狀態
VITE_DEBUG_CONNECTION=false

# AI API 配置
# Gemini API (用於 AI 文案生成和備用修復)
GEMINI_API_KEY=your_gemini_api_key_here

# SiliconFlow API (主要 AI 審查服務)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Groq API (備用 AI 服務)
GROQ_API_KEY=your_groq_api_key_here

# 天氣 API (OpenWeatherMap)
VITE_WEATHER_PROVIDER=openweathermap
VITE_WEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# 天氣 API (中央氣象署 CWA)
# VITE_WEATHER_PROVIDER=cwb
# VITE_WEATHER_API_KEY=your_cwa_api_key_here
# VITE_WEATHER_API_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore
